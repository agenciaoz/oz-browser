# Build artifacts
.webpack
out
dist
*.log

# Webpack-bundled preloads (generated build artifacts inside .webpack/).
# NOTE: do NOT use a bare `preload.js` here — it would also match `/preload.js`
# at the project root, which is the SOURCE entry point that webpack consumes
# (see forge.config.js → entryPoints.preload.js). Source preload must be commited.
.webpack/**/preload.js
.webpack/**/preload.js.map

# Dependencies
node_modules/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Local user data (Identities, proxies, settings — NEVER commit)
data/
proxies.json
*.proxies.json
.env
.env.local

# macOS code signing
*.p12
*.cer
*.mobileprovision
