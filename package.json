{
  "name": "oz-browser",
  "productName": "OZ Browser",
  "version": "2.0.0-alpha.82",
  "description": "Multi-session Chromium browser with per-tab proxies and antidetect — based on Electron.",
  "main": ".webpack/main",
  "scripts": {
    "build": "npm run package",
    "bundle:preloads": "node scripts/bundle-preloads.js",
    "prestart": "node scripts/bundle-preloads.js",
    "prepackage": "node scripts/bundle-preloads.js",
    "start": "electron-forge start",
    "start:trace": "electron-forge start -- --trace-startup=\"*\" --trace-startup-file=\"$HOME/Desktop/trace.json\"",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "postpublish": "node scripts/publish-yml.js",
    "test": "for t in tests/*.smoketest.js; do node \"$t\" || exit 1; done",
    "test:safe": "bash scripts/safe-test.sh",
    "check:loc": "node scripts/check-loc.js",
    "check:loc:verbose": "OZ_LOC_VERBOSE=1 node scripts/check-loc.js",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "license": "UNLICENSED",
  "author": "Jose <joserodrigo@gmail.com>",
  "private": true,
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@noble/curves": "^2.2.0",
    "@paypal/paypal-server-sdk": "^2.3.0",
    "@supabase/supabase-js": "^2.105.4",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "dropbox": "^10.34.0",
    "electron-chrome-context-menu": "^1.1.0",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "otplib": "^13.4.0",
    "sql.js": "^1.14.1",
    "update-electron-app": "^3.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-dmg": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.5.0",
    "@electron-forge/plugin-webpack": "^7.5.0",
    "@electron-forge/publisher-github": "^7.11.1",
    "@eslint/js": "^9.39.4",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.2",
    "electron": "^42.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
