<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      OZ Browser entitlements para hardened runtime + notarización (Etapa 3b/3c).
      Mínimo viable para que Electron 42 + native modules + WebRTC funcionen.
    -->

    <!-- Electron / V8 / native modules -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Browsing -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- MCP server local en :9223 (off por default, opt-in via OZ_MCP_ENABLED=1) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- WebRTC: sites como Meet, Zoom, Tella necesitan cam/mic. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- File access para Excel I/O (Bloque 1.5e) y Time Machine snapshots
         (Bloque 1.6) cuando el user elige paths fuera del sandbox via
         dialog.showOpenDialog/showSaveDialog. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Permite que la app reciba el deep link oz://auth/callback (Etapa 4)
         y oz://billing/* (Etapa 5). El registro del scheme va en main.js
         con app.setAsDefaultProtocolClient('oz'). -->
  </dict>
</plist>
