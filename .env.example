# OZ Browser — local environment template.
#
# Copy this file to `.env` and fill in real values. The `.env` is gitignored.
# Forge / webpack reads these at build time (NODE_ENV-aware) and the OZ
# Browser .app embeds the publishable values as build-time constants. Secret
# values stay local — they NEVER get bundled into the .app.
#
# Don't quote values. Lines starting with # are comments.

# ---------- Supabase (Etapa 4 — Auth + entitlements) -------------------------

# Project URL — derived from the project ref. Safe to ship in .app.
SUPABASE_URL=https://ajubxmfrlolifsdnibgx.supabase.co

# Publishable key (new format, replaces legacy anon JWT). Embeddable in .app:
# any client can read it, but Row Level Security policies enforce per-user
# scoping at the database. Safe to commit to publishable env / public CI.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXX

# Secret key (new format, replaces legacy service_role JWT). Server-side
# ONLY. Used by `scripts/migrate.js` and similar admin tools. NEVER in .app,
# NEVER in git, NEVER in CI logs.
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXX

# Optional — direct Postgres connection for `psql` admin. Only if we run
# raw SQL outside the Supabase Studio. Settings → Database → Connection.
# SUPABASE_DB_PASSWORD=

# ---------- OZ runtime ------------------------------------------------------

# Enable MCP server on 127.0.0.1:9223 at boot. Also toggleable via the
# Settings UI (automation.mcpEnabled). Either source flips it on.
# OZ_MCP_ENABLED=1

# Tier override — bypasses the 3-identity free cap during development.
# OZ_TIER=paid

# Dry-run the identity↔workspace migration without writing to disk.
# OZ_MIGRATION_DRY_RUN=1
